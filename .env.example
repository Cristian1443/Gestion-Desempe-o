# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/gestion_desempeno?schema=public"

# Solo usado por docker-compose.yml: puerto del HOST donde queda expuesta la
# app (el contenedor sigue escuchando en 3000 por dentro). Cambialo si ese
# puerto ya está ocupado en el servidor (ej. por otra app) — ver DEPLOY-QA.md.
APP_PORT="3000"

# Auth.js (NextAuth v5)
AUTH_SECRET="" # generar con: npx auth secret
AUTH_URL="http://localhost:3000"

# Microsoft Entra ID (Azure AD) — SSO, sin usuarios/contraseñas propias
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"

# Envío de recordatorios por correo (se define en la fase de seguimiento)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="gestion.desempeno@investinbogota.org"

# Migración desde SharePoint (se define en la fase de migración)
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
SHAREPOINT_SITE_ID=""
