// Gestión del Desempeño — Invest in Bogotá
// Modelo de datos completo. Ver /prisma/constraints.sql para las validaciones
// a nivel de base de datos que Prisma aún no expresa de forma nativa
// (reglas de integridad entre `nivel` y las FKs de `usuarioId` / `gerenciaId`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Rol {
  COLABORADOR
  JEFE
  GERENTE
  // Encargado de crear los 8 objetivos corporativos al inicio del periodo y
  // de registrar su seguimiento en cada franja — un rol acotado a esa sola
  // tarea, sin los demás poderes de GESTION_HUMANA/ADMIN (periodos,
  // seguimientos, estructura organizacional).
  GESTOR_CORPORATIVO
  GESTION_HUMANA
  ADMIN
}

enum NivelObjetivo {
  INDIVIDUAL
  GERENCIA
  CORPORATIVO
}

// Solo aplica a nivel INDIVIDUAL: los objetivos de desempeño se miden contra
// una línea estratégica corporativa (ver LineaEstrategica); los de
// desarrollo se miden contra una competencia a fortalecer (texto libre en
// `competencia`, no hay catálogo fijo).
enum TipoObjetivoIndividual {
  DESEMPENO
  DESARROLLO
}

// Catálogo fijo de líneas estratégicas corporativas. Solo se usa en
// objetivos INDIVIDUAL de tipo DESEMPENO.
enum LineaEstrategica {
  L1
  L2
  L3
  L4
  L5
}

// El periodo solo se abre y se cierra a mano. Lo que ocurre dentro (cuándo se
// puede registrar un seguimiento y cuándo se pone el % de cumplimiento) lo
// deciden las franjas de fechas, ver `Seguimiento` y `Periodo.cumplimiento*`.
enum EstadoPeriodo {
  BORRADOR
  ABIERTO
  CERRADO
}

// Flujo definido: el colaborador (o gerente/GH, según nivel) propone el
// objetivo y el jefe directo (o el rol correspondiente al nivel) lo aprueba.
enum EstadoAprobacionObjetivo {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  DEVUELTO
}

enum EstadoEvaluacion {
  EN_PROGRESO
  CALIFICADO
  CERRADO
}

// ---------------------------------------------------------------------------
// Identidad y estructura organizacional
// ---------------------------------------------------------------------------

model Usuario {
  id     String  @id @default(cuid())
  // Nulo mientras el colaborador está "pre-registrado" (dado de alta por
  // Talento Humano en la estructura organizacional) pero todavía no ha
  // iniciado sesión ni una sola vez con su cuenta corporativa. Se completa
  // solo, automáticamente, la primera vez que esa persona entra por SSO:
  // el callback de login lo empareja por `email` y lo vincula (ver
  // `resolverUsuarioParaLogin` en usuarios.service.ts). Postgres permite
  // múltiples NULL bajo un índice único, así que varios pendientes pueden
  // coexistir sin chocar contra el `@unique`.
  entraObjectId String? @unique @map("entra_object_id")
  email         String  @unique
  nombre        String
  cargo         String?
  activo        Boolean @default(true)

  // Foto de perfil traída de Microsoft Graph (la misma que se ve en Teams/
  // Outlook). Se guarda como bytes en vez de solo una URL porque la foto de
  // Graph requiere un token de acceso para descargarse — no se puede
  // referenciar directo desde el navegador. La trae y actualiza
  // `sincronizar-grupo.mjs` en cada corrida (ver ese script). Nula si la
  // persona no tiene foto configurada en Entra ID.
  foto            Bytes?    @map("foto")
  fotoTipo        String?   @map("foto_tipo")
  fotoActualizada DateTime? @map("foto_actualizada")

  gerenciaId String?   @map("gerencia_id")
  gerencia   Gerencia? @relation("ColaboradoresDeGerencia", fields: [gerenciaId], references: [id])

  jefeId        String?   @map("jefe_id")
  jefe          Usuario?  @relation("JefeColaborador", fields: [jefeId], references: [id])
  colaboradores Usuario[] @relation("JefeColaborador")

  // Gerencia de la que este usuario es el gerente (relación 1:1 inversa).
  gerenciaComoGerente Gerencia? @relation("GerenteDeGerencia")

  roles UsuarioRol[]

  objetivosPropios    Objetivo[] @relation("ObjetivoUsuario")
  objetivosCreados    Objetivo[] @relation("ObjetivoCreadoPor")
  objetivosAprobados  Objetivo[] @relation("ObjetivoAprobadoPor")
  objetivosCalificados Objetivo[] @relation("ObjetivoCalificadoPor")

  seguimientosRegistrados RegistroSeguimiento[] @relation("SeguimientoRegistradoPor")
  avancesRegistrados      AvanceIndicador[]     @relation("AvanceRegistradoPor")

  evaluaciones Evaluacion[]
  auditorias   Auditoria[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([gerenciaId])
  @@index([jefeId])
  @@map("usuarios")
}

// Un usuario puede tener varios roles simultáneos (ej. GERENTE + JEFE).
model UsuarioRol {
  id        String  @id @default(cuid())
  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([usuarioId, rol])
  @@map("usuario_roles")
}

model Gerencia {
  id        String  @id @default(cuid())
  nombre    String  @unique
  gerenteId String? @unique @map("gerente_id")
  gerente   Usuario? @relation("GerenteDeGerencia", fields: [gerenteId], references: [id])

  colaboradores Usuario[]  @relation("ColaboradoresDeGerencia")
  objetivos     Objetivo[] @relation("ObjetivoGerencia")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("gerencias")
}

// ---------------------------------------------------------------------------
// Periodos y seguimientos
// ---------------------------------------------------------------------------

model Periodo {
  id          String        @id @default(cuid())
  nombre      String        @unique // ej. "2026" (el periodo es anual, no semestral)
  fechaInicio DateTime      @map("fecha_inicio")
  fechaFin    DateTime      @map("fecha_fin")
  estado      EstadoPeriodo @default(BORRADOR)

  // Franja de fechas (inclusive) en la que se pone el % de cumplimiento final
  // de cada objetivo. La define Talento Humano y puede terminar después de
  // `fechaFin` (la evaluación se hace al cierre del año). Nulas hasta que se
  // definan; sin franja nadie puede poner el % final.
  cumplimientoInicio DateTime? @map("cumplimiento_inicio")
  cumplimientoFin    DateTime? @map("cumplimiento_fin")

  objetivos    Objetivo[]
  seguimientos Seguimiento[]
  evaluaciones Evaluacion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("periodos")
}

// Seguimiento numerado de un periodo (Seguimiento 1, 2… N). Talento Humano
// define cuántos hay y la franja de fechas (inclusive) de cada uno; el sistema
// decide solo, por la fecha de hoy, cuál está en curso, así que nadie abre ni
// cierra nada a mano. Las franjas no se traslapan y aplican a los 3 niveles
// de objetivo por igual. Lo que cada persona escribe en un seguimiento queda
// en `RegistroSeguimiento`.
model Seguimiento {
  id          String   @id @default(cuid())
  periodoId   String   @map("periodo_id")
  periodo     Periodo  @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  numero      Int
  fechaInicio DateTime @map("fecha_inicio")
  fechaFin    DateTime @map("fecha_fin")

  registros RegistroSeguimiento[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([periodoId, numero])
  @@map("seguimientos")
}

// ---------------------------------------------------------------------------
// Objetivos (los 3 niveles conviven en la misma tabla, discriminados por `nivel`)
// ---------------------------------------------------------------------------

model Objetivo {
  id        String        @id @default(cuid())
  periodoId String        @map("periodo_id")
  periodo   Periodo       @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  nivel     NivelObjetivo

  // Solo para nivel INDIVIDUAL.
  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation("ObjetivoUsuario", fields: [usuarioId], references: [id])

  // Solo para nivel GERENCIA.
  gerenciaId String?   @map("gerencia_id")
  gerencia   Gerencia? @relation("ObjetivoGerencia", fields: [gerenciaId], references: [id])

  // Nivel CORPORATIVO no lleva usuarioId ni gerenciaId (aplica a toda la organización).

  // Solo para nivel INDIVIDUAL: clasifica el objetivo como de desempeño (va
  // contra una línea estratégica) o de desarrollo (va contra una
  // competencia). Obligatorio para INDIVIDUAL, nulo en los demás niveles.
  tipoIndividual TipoObjetivoIndividual? @map("tipo_individual")
  // Solo cuando tipoIndividual = DESEMPENO.
  lineaEstrategica LineaEstrategica? @map("linea_estrategica")
  // Solo cuando tipoIndividual = DESARROLLO (texto libre, ej. "Liderazgo",
  // "Comunicación asertiva").
  competencia String? @map("competencia")
  // Enlace a la carpeta/repositorio donde se recopila la evidencia del
  // objetivo durante el periodo.
  linkRepositorio String? @map("link_repositorio")
  // Solo para nivel INDIVIDUAL: las acciones concretas para lograr el
  // objetivo (distinto de `descripcion`, que es el objetivo en sí).
  acciones String?

  // `titulo` es un encabezado corto para listas/tarjetas — en INDIVIDUAL se
  // deriva automáticamente de `descripcion` (no hay un campo de título en el
  // formulario: la planilla original de Power Apps ya lo traía como texto
  // autogenerado sin valor real, ej. "Obj 6 - Nombre Persona").
  titulo String

  descripcion String
  // `meta` y `unidadMedida` no aplican a objetivos INDIVIDUAL (no existían en
  // la herramienta anterior para ese nivel); siguen siendo obligatorios para
  // GERENCIA y CORPORATIVO.
  meta         String?
  indicador    String
  unidadMedida String? @map("unidad_medida")

  // Ningún objetivo lleva ya peso: siempre queda en 0 (la nota final ponderada
  // no está conectada; ver calculo-notas.ts). Se conserva la columna.
  peso Decimal @db.Decimal(5, 2)

  estadoAprobacion     EstadoAprobacionObjetivo @default(BORRADOR) @map("estado_aprobacion")
  comentarioAprobacion String?                  @map("comentario_aprobacion")

  creadoPor String  @map("creado_por")
  creador   Usuario @relation("ObjetivoCreadoPor", fields: [creadoPor], references: [id])

  aprobadoPor     String?   @map("aprobado_por")
  aprobador       Usuario?  @relation("ObjetivoAprobadoPor", fields: [aprobadoPor], references: [id])
  fechaAprobacion DateTime? @map("fecha_aprobacion")

  // % de cumplimiento (0-100) de un objetivo INDIVIDUAL de desempeño, que pone el
  // jefe una sola vez al final, dentro de la franja del resultado final. De ahí sale
  // `cumplido` (80 o más cumple). Los indicadores de gerencia y de la empresa no lo
  // usan: solo Cumple / No cumple. (Quién califica: ver `calificadoPor`.)
  calificacionFinal Decimal?  @map("calificacion_final") @db.Decimal(5, 2)
  calificadoPor     String?   @map("calificado_por")
  calificador       Usuario?  @relation("ObjetivoCalificadoPor", fields: [calificadoPor], references: [id])
  fechaCalificacion DateTime? @map("fecha_calificacion")

  // Solo para objetivos INDIVIDUAL de tipo DESARROLLO: no llevan nota
  // numérica (no tienen peso), así que el jefe simplemente marca si se
  // cumplieron o no al momento de la calificación final. Es informativo — no
  // entra al cálculo de la nota individual (ver calculo-notas.ts).
  cumplioDesarrollo Boolean? @map("cumplio_desarrollo")

  // Resultado final Cumple / No cumple, sin peso, que se marca una sola vez
  // dentro de la franja del resultado final del periodo: el jefe en los
  // objetivos individuales de desempeño, el gerente en los de gerencia y la
  // persona encargada en los indicadores de la empresa. No aplica a desarrollo.
  cumplido Boolean? @map("cumplido")

  // En los indicadores (CORPORATIVO y GERENCIA): la línea estratégica (L1 a L4) usa
  // `lineaEstrategica`, el objetivo estratégico se guarda en `descripcion` y el
  // indicador en `titulo`.

  seguimientos RegistroSeguimiento[]
  // Solo CORPORATIVO: avance mes a mes del indicador.
  avances AvanceIndicador[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([periodoId, nivel])
  @@index([usuarioId])
  @@index([gerenciaId])
  @@map("objetivos")
}

// ---------------------------------------------------------------------------
// Seguimiento de ejecución (histórico, nunca se sobrescribe)
// ---------------------------------------------------------------------------

// Bitácora de seguimiento: en cada seguimiento del periodo, quien le hace
// seguimiento al objetivo (el jefe para individuales, el gerente para los de
// gerencia) deja un comentario con fecha. Para individuales es una nota de
// proceso, sin porcentaje: su % de cumplimiento (`Objetivo.calificacionFinal`)
// es un juicio aparte que se pone una sola vez, al final, dentro de la franja
// del periodo. Los indicadores de gerencia, en cambio, llevan además el % de
// avance acumulado de ese seguimiento (`porcentaje`, obligatorio para ellos en
// el servicio; el CHECK de 0-100 vive en la migración).
//
// Cada seguimiento puede tener más de un registro por objetivo: quien lo hace
// puede corregir su comentario creando una versión nueva en vez de editar la
// anterior. `version` es el correlativo dentro de (objetivoId, seguimientoId);
// la de mayor número es la vigente.
model RegistroSeguimiento {
  id            String      @id @default(cuid())
  objetivoId    String      @map("objetivo_id")
  objetivo      Objetivo    @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  seguimientoId String      @map("seguimiento_id")
  seguimiento   Seguimiento @relation(fields: [seguimientoId], references: [id])
  version       Int         @default(1)

  porcentaje Int?
  comentario String

  registradoPor String  @map("registrado_por")
  registrador   Usuario @relation("SeguimientoRegistradoPor", fields: [registradoPor], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([objetivoId, seguimientoId, version])
  @@index([seguimientoId])
  @@map("registros_seguimiento")
}

// Avance mensual de un indicador de la empresa (objetivo CORPORATIVO): un
// registro por mes calendario con el % acumulado (0-100, ej. "en octubre vamos
// en 60%") y un comentario. Se puede registrar el mes en curso y completar o
// corregir meses anteriores, nunca meses futuros. Corregir un mes crea una
// versión nueva (queda la de mayor número), igual que `RegistroSeguimiento`.
// El CHECK de 0-100 de `porcentaje` vive en la propia migración.
model AvanceIndicador {
  id         String   @id @default(cuid())
  objetivoId String   @map("objetivo_id")
  objetivo   Objetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  // Primer día del mes, a medianoche UTC.
  mes        DateTime
  version    Int      @default(1)

  porcentaje Int
  comentario String

  registradoPor String  @map("registrado_por")
  registrador   Usuario @relation("AvanceRegistradoPor", fields: [registradoPor], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([objetivoId, mes, version])
  @@index([objetivoId])
  @@map("avances_indicador")
}

// ---------------------------------------------------------------------------
// Evaluación consolidada por colaborador y periodo
// ---------------------------------------------------------------------------

model Evaluacion {
  id        String  @id @default(cuid())
  periodoId String  @map("periodo_id")
  periodo   Periodo @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  notaIndividual  Decimal? @map("nota_individual") @db.Decimal(5, 2)
  notaGerencia    Decimal? @map("nota_gerencia") @db.Decimal(5, 2)
  notaCorporativa Decimal? @map("nota_corporativa") @db.Decimal(5, 2)
  notaFinal       Decimal? @map("nota_final") @db.Decimal(5, 2)

  estado      EstadoEvaluacion @default(EN_PROGRESO)
  calculadoEn DateTime?        @map("calculado_en")
  fechaCierre DateTime?        @map("fecha_cierre")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([periodoId, usuarioId])
  @@map("evaluaciones")
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model Auditoria {
  id        String  @id @default(cuid())
  entidad   String // ej. "Objetivo", "Evaluacion", "Periodo"
  entidadId String  @map("entidad_id")
  accion    String // ej. "CREATE" | "UPDATE" | "DELETE" | "CIERRE_PERIODO"
  campo     String?
  valorAnterior Json? @map("valor_anterior")
  valorNuevo    Json? @map("valor_nuevo")

  realizadoPor String  @map("realizado_por")
  usuario      Usuario @relation(fields: [realizadoPor], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entidad, entidadId])
  @@map("auditoria")
}
